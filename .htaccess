RewriteEngine On

# Clean URLs for KVKK Aydınlatma Metni & Haberler Blog
RewriteRule ^kvkk-aydinlatma-metni/?$ kvkk-aydinlatma-metni.html [L,QSA]
RewriteRule ^haberler/?$ haberler.html [L,QSA]

# LLM & AI Agent Standard Endpoints (.well-known/llms.txt & ai.txt)
RewriteRule ^\.well-known/llms\.txt$ llms.txt [L,QSA]
RewriteRule ^\.well-known/llms-full\.txt$ llms-full.txt [L,QSA]
RewriteRule ^ai\.txt$ llms.txt [L,QSA]

# Ensure UTF-8 encoding for LLM markdown/text context files
AddDefaultCharset UTF-8
<FilesMatch "\.(txt|xml|json)$">
  AddCharset UTF-8 .txt .xml .json
</FilesMatch>

# Prevent aggressive browser and CDN caching of HTML, JS, CSS, and media assets
<IfModule mod_headers.c>
  <FilesMatch "\.(html?|js|css|png|jpe?g|gif|webp|svg|ico)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
  <FilesMatch "^(llms|llms-full)\.txt$">
    Header set Content-Type "text/plain; charset=utf-8"
    Header set Access-Control-Allow-Origin "*"
    Header set X-Robots-Tag "all"
  </FilesMatch>
</IfModule>
